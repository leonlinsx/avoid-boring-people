{
  "name": "leonlins-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --open",
    "build": "astro build",
    "preview": "astro preview --open",
    "astro": "astro",
    "lint": "eslint .",
    "start": "npm run build && npm run preview",
    "debug:tags": "astro run scripts/debug-tags.ts",
    "newsletter:import:dry-run": "node --import ts-node/esm scripts/newsletter/inspect-substack-export.ts",
    "newsletter:import": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/newsletter/import-substack-export.ts",
    "newsletter:campaign": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/newsletter/create-campaign.ts",
    "newsletter:preview": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/newsletter/preview.ts",
    "newsletter:send": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/newsletter/send-campaign.ts",
    "newsletter:test": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/newsletter/test-send.ts",
    "comments:list": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/comments/list.ts",
    "comments:hide": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/comments/hide.ts",
    "comments:restore": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/comments/restore.ts",
    "comments:delete": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/comments/delete.ts",
    "comments:reply": "node --env-file-if-exists=.env.local --import ts-node/esm scripts/comments/reply.ts",
    "linkcheck:internal": "NO_PROXY=\"${NO_PROXY:+$NO_PROXY,}localhost,127.0.0.1\" no_proxy=\"${no_proxy:+$no_proxy,}localhost,127.0.0.1\" node scripts/link-report.js internal",
    "linkcheck:external": "node scripts/link-report.js external",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --import ./tests/register-loaders.mjs --loader ts-node/esm tests/run-tests.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.5",
    "@astrojs/preact": "^4.1.1",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/vercel": "^9.0.5",
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "astro": "^5.18.2",
    "csv-parse": "^6.2.1",
    "fontkit": "^2.0.4",
    "fuse.js": "^7.1.0",
    "lucide-astro": "^0.544.0",
    "lucide-react": "^0.544.0",
    "playwright": "^1.55.0",
    "preact": "^10.27.2",
    "puppeteer": "^24.22.0",
    "reading-time": "^1.5.0",
    "rehype-stringify": "10.0.1",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "^0.34.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-prettier": "^5.5.4",
    "linkinator": "^6.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}

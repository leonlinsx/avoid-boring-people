[Unit]
Description=Generate and automatically admit low-risk ABP Reel inventory

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/bin/abp-instagram-auto --limit 12
LoadCredential=auto-admission-key:%h/.config/abp-instagram/auto-admission-ed25519.pem
TimeoutStartSec=7200
NoNewPrivileges=true
UMask=0077

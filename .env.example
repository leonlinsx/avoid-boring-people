# Local-only CLI configuration. Never add this to GitHub or Vercel.
GOOGLE_CLOUD_PROJECT=

# Standard editorial mail ignores this value and has no address requirement.
# Reserved for explicit sender-identification opt-in after commercial-use review.
# Keep any real mailing address private, never in Git.
NEWSLETTER_POSTAL_ADDRESS=
# Optional description-based inbox snippet; exact false disables it.
NEWSLETTER_PREHEADER_ENABLED=true

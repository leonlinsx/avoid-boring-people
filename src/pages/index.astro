---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { enrichPost } from '../utils/text'; // ✅ import enrichment + helpers
import SubscribeForm from '../components/SubscribeForm.astro';

const allPosts = await getCollection('blog');

// Enrich all posts once for reuse below
const enrichedPosts = allPosts.map(enrichPost);

// Pick featured posts, enriched
const featured = enrichedPosts
  .filter((post) => post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={SITE_TITLE}
  description="Writing by Leon Lin on investing, technology, systems, and how things work."
>
  <!-- Hero -->
  <section class="hero">
    <h1>Leon Lin</h1>
    <p class="hero-hook">
      I write to understand how investing, technology, and systems actually
      work, plus whatever else catches my attention.
    </p>
    <p class="hero-credentials">
      I've spent my career across finance and technology — investment banking,
      fundamental long/short investing, quantitative finance, startups, and
      large technology companies. These days I also build systems and software
      to help me research, analyze, and make better decisions.
    </p>
  </section>

  <!-- Start Here -->
  <section id="selected-work" class="content-section">
    <h2>Selected Work</h2>
    <p class="subtext">A few things that best represent how I think.</p>
    <PostList posts={featured} />
  </section>

  <!-- Newsletter Signup -->
  <section id="subscribe" class="signup">
    <SubscribeForm
      title="Join 5,000+ readers"
      subtext="Mostly investing, technology, and how things work. Occasionally something completely different."
    />
  </section>

  <!-- Featured Logos -->
  <section class="featured">
    <h2>As featured in</h2>
    <div class="logo-row">
      <img
        src="/logos/hacker_news_logo.webp"
        alt="Hacker News logo"
        loading="lazy"
      />
      <img src="/logos/failory_logo.webp" alt="Failory logo" loading="lazy" />
      <img src="/logos/finextra_logo.webp" alt="Finextra logo" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: none;
    margin: var(--space-lg) 0;
    text-align: left;
  }

  .hero h1 {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .hero-hook {
    max-width: 50ch;
    margin-bottom: var(--space-md);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.4;
  }

  .hero-credentials {
    max-width: 70ch;
    margin-bottom: 0;
    color: var(--color-text-muted);
  }
</style>

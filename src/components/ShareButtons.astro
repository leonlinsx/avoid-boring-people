---
import { Share2 } from 'lucide-astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedURL = encodeURIComponent(url);
---

<div class="share-control" data-share-control data-title={title} data-url={url}>
  <button
    type="button"
    id="share-toggle"
    class="share-toggle"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="share-menu"
  >
    <Share2 class="icon" aria-hidden="true" />
    Share
  </button>
  <div
    id="share-menu"
    class="share-menu"
    role="menu"
    aria-labelledby="share-toggle"
    hidden
  >
    <button type="button" role="menuitem" data-copy-link>Copy link</button>
    <a
      href={`https://www.threads.net/intent/post?text=${encodedTitle}%20${encodedURL}`}
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      data-share="Threads">Threads</a
    >
    <a
      href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedURL}`}
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      data-share="Twitter">X/Twitter</a
    >
    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedURL}`}
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      data-share="LinkedIn">LinkedIn</a
    >
    <a
      href={`mailto:?subject=${encodedTitle}&body=${encodedURL}`}
      role="menuitem"
      data-share="Email">Email</a
    >
  </div>
  <span class="sr-only" role="status" aria-live="polite" data-share-status
  ></span>
</div>

<script is:inline>
  function trackShare(platform) {
    if (window.gtag) {
      // eslint-disable-next-line no-undef
      gtag('event', 'share', {
        event_category: 'engagement',
        event_label: platform,
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-share-control]').forEach((control) => {
      const toggle = control.querySelector('.share-toggle');
      const menu = control.querySelector('.share-menu');
      const status = control.querySelector('[data-share-status]');
      const items = Array.from(
        menu?.querySelectorAll('[role="menuitem"]') ?? [],
      );
      if (
        !(toggle instanceof HTMLButtonElement) ||
        !(menu instanceof HTMLElement)
      )
        return;

      const closeMenu = (returnFocus = false) => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        if (returnFocus) toggle.focus();
      };
      const openMenu = () => {
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        if (items[0] instanceof HTMLElement) items[0].focus();
      };

      toggle.addEventListener('click', async (event) => {
        event.stopPropagation();
        const useNativeShare =
          typeof navigator.share === 'function' &&
          window.matchMedia('(pointer: coarse)').matches;
        if (useNativeShare) {
          try {
            await navigator.share({
              title: control.dataset.title,
              url: control.dataset.url,
            });
            trackShare('Native');
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError')
              return;
          }
        }
        if (menu.hidden) openMenu();
        else closeMenu();
      });

      control.querySelectorAll('[data-share]').forEach((link) => {
        link.addEventListener('click', () => {
          trackShare(link.dataset.share);
          closeMenu();
        });
      });

      control
        .querySelector('[data-copy-link]')
        ?.addEventListener('click', async () => {
          const shareURL = control.dataset.url ?? location.href;
          try {
            await navigator.clipboard.writeText(shareURL);
          } catch {
            const input = document.createElement('textarea');
            input.value = shareURL;
            input.setAttribute('readonly', '');
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.append(input);
            input.select();
            void document.execCommand('copy');
            input.remove();
          }
          trackShare('Copy link');
          if (status) status.textContent = 'Link copied';
          closeMenu(true);
        });

      menu.addEventListener('keydown', (event) => {
        const current = items.indexOf(document.activeElement);
        let next = -1;
        if (event.key === 'ArrowDown') next = (current + 1) % items.length;
        if (event.key === 'ArrowUp')
          next = (current - 1 + items.length) % items.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = items.length - 1;
        if (next >= 0 && items[next] instanceof HTMLElement) {
          event.preventDefault();
          items[next].focus();
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) closeMenu(true);
      });
      document.addEventListener('click', (event) => {
        if (!menu.hidden && !control.contains(event.target)) closeMenu();
      });
    });
  });
</script>

<style>
  .share-control {
    position: relative;
    flex: none;
    font-size: var(--text-sm);
  }
  .share-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    cursor: pointer;
  }
  .share-toggle:hover {
    color: var(--color-link);
  }
  .share-toggle:focus-visible,
  .share-menu :is(a, button):focus-visible {
    border-radius: var(--radius-sm);
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
  .icon {
    width: 1rem;
    height: 1rem;
  }
  .share-menu {
    position: absolute;
    z-index: 10;
    top: calc(100% + var(--space-sm));
    right: 0;
    width: max-content;
    min-width: 9.5rem;
    padding: var(--space-xs) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }
  .share-menu[hidden] {
    display: none;
  }
  .share-menu :is(a, button) {
    display: block;
    width: 100%;
    padding: var(--space-xs) var(--space-md);
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .share-menu :is(a, button):hover {
    background: var(--color-border-soft);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

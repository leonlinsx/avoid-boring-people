---
interface Props {
  compact?: boolean;
  title?: string;
  subtext?: string;
  trustText?: string;
  /** Visible CTA copy; English by default. */
  emailLabel?: string;
  emailPlaceholder?: string;
  subscribeLabel?: string;
  successFull?: string;
  successCompact?: string;
}

const {
  compact = false,
  title = compact ? '' : 'Get the next essay',
  subtext = '',
  trustText = '',
  emailLabel = 'Email address',
  emailPlaceholder = 'Enter your email',
  subscribeLabel = 'Subscribe',
  successFull = 'If this address can receive this newsletter, check your inbox (including spam). If a confirmation email arrives, use its link to complete signup.',
  successCompact = 'If eligible, check your inbox. Use the link if a confirmation email arrives.',
} = Astro.props;
const formId = `newsletter-${crypto.randomUUID()}`;
---

<section class="signup">
  {!compact && title && <h2>{title}</h2>}
  {!compact && subtext && <p class="subtext">{subtext}</p>}

  <form
    id={formId}
    data-newsletter-form
    class:list={['signup-box', compact && 'compact']}
    action="/api/newsletter/subscribe"
    method="post"
    data-success-full={successFull}
    data-success-compact={successCompact}
  >
    <input
      type="hidden"
      name="source"
      value={compact ? 'blog-inline' : 'blog-footer'}
    />

    <label for={`${formId}-email`} class="sr-only">{emailLabel}</label>
    <input
      id={`${formId}-email`}
      type="email"
      name="email"
      placeholder={emailPlaceholder}
      required
      autocomplete="email"
      maxlength="320"
      aria-describedby={`${formId}-message`}
    />
    <div class="sr-only" aria-hidden="true">
      <label for={`${formId}-website`}>Leave this field empty</label>
      <input
        id={`${formId}-website`}
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <button type="submit">{subscribeLabel}</button>
  </form>

  <p id={`${formId}-message`} class="subscribe-message" aria-live="polite"></p>

  <noscript
    >Please enable JavaScript to subscribe, or visit <a
      href="https://avoidboringpeople.substack.com/subscribe">Substack</a
    >.</noscript
  >

  {!compact && trustText && <p class="trust-text">{trustText}</p>}
</section>

<script>
  import { initializeNewsletterForms } from '../lib/newsletter/signup-form';
  initializeNewsletterForms();
</script>

<style>
  /* Compact adjustments only */
  .signup-box.compact {
    padding: var(--space-xs) var(--space-sm);
    max-width: 360px;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .signup-box.compact input {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-sm);
  }
  .signup-box.compact button {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-sm);
  }

  /* Accessibility helper */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

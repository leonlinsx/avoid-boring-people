---
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props; // ✅ ensures tags is always an array
---

{
  tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.toLowerCase()}`}>{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) 0;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-meta);
    font-size: var(--text-sm);
  }
  .tag-list li:not(:last-child)::after {
    content: '·';
    margin: 0 var(--space-sm);
    color: var(--color-text-meta);
  }
  .tag-list a {
    color: var(--color-text-muted);
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  .tag-list a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
  .tag-list a:focus-visible {
    border-radius: var(--radius-sm);
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }
</style>

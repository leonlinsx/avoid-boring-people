---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import { SITE_AUTHOR, SITE_OG_IMAGE, SITE_URL } from '../consts';
import { enrichPost } from '../utils/text';
import { selectRelatedPosts } from '../utils/related-posts';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TagList from '../components/TagList.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Discussion from '../components/Discussion.astro';
import type { MarkdownHeading } from 'astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { categoryLabel } from '../utils/taxonomy';
import { articleHeroUrl } from '../utils/hero';
import LanguageSelector from '../components/LanguageSelector.astro';
import {
  ENGLISH,
  articleChrome,
  availableLocalesForEntry,
  buildHreflangLinks,
  contentEntryName,
  englishPathname,
  languageSelectorEntries,
  localeByCode,
  localizeRelatedPosts,
  localizedPathname,
  newsletterChrome,
} from '../utils/i18n';

type Props = {
  post: CollectionEntry<'blog'> & { slug: string };
  headings?: MarkdownHeading[];
  /** BCP47 locale code when rendering a translation; omitted for English. */
  locale?: string;
  translatedTitle?: string;
  translatedDescription?: string;
};

const {
  post,
  headings = [],
  locale,
  translatedTitle,
  translatedDescription,
} = Astro.props;
const translationLocale = locale ? localeByCode(locale) : undefined;

// ✅ Enrich once, then destructure from .data
const enrichedPost = enrichPost(post);
const {
  title: englishTitle,
  description: englishDescription,
  pubDate,
  updatedDate,
  heroImage,
  category,
  categoryNormalized,
  tags = [],
  readingTime,
  discussionPrompt,
} = enrichedPost.data;
const slug = enrichedPost.slug;
const hero = heroImage;

// Translated pages reuse the English shell (dates, category, tags, hero,
// related posts, discussion) and only swap the reading strings.
const title = translatedTitle ?? englishTitle;
const description = translatedDescription ?? englishDescription;
const chrome = articleChrome(translationLocale?.code);
const dateLocale = translationLocale?.dateLocale ?? ENGLISH.dateLocale;
const canonicalPath = translationLocale
  ? localizedPathname(translationLocale.prefix, slug)
  : englishPathname(slug);

// Versions that actually exist, for hreflang and the language selector.
const availableCodes = availableLocalesForEntry(contentEntryName(post.id));
const hreflangs = buildHreflangLinks({
  siteOrigin: SITE_URL,
  slug,
  availableCodes,
});
const currentCode = translationLocale?.code ?? ENGLISH.code;
const langEntries = languageSelectorEntries({
  slug,
  currentCode,
  availableCodes,
});
const currentLabel =
  langEntries.find((entry) => entry.isCurrent)?.label ?? ENGLISH.label;
const pageOgLocale = translationLocale?.ogLocale ?? ENGLISH.ogLocale;
const ogLocaleAlternates = [
  ENGLISH.ogLocale,
  ...availableCodes.flatMap((code) => localeByCode(code)?.ogLocale ?? []),
].filter((value) => value !== pageOgLocale);

// Social image reuses the rendered hero transform, so `og:image` and
// `BlogPosting.image` point at the deployed 1200x630 asset instead of the
// smaller original source. Hero-less articles use the metadata-only fallback.
const socialImage = (await articleHeroUrl(hero)) ?? SITE_OG_IMAGE;

// ✅ Related posts reuse the English selection. On a localized page only the
// selected posts that have a translation in the current locale are shown,
// with localized titles and URLs; with none, the section is omitted entirely.
const allPosts = await getCollection('blog');
const related = selectRelatedPosts(post, allPosts).map(enrichPost);
const relatedTranslations = translationLocale
  ? new Map(
      (await getCollection('i18n'))
        .filter((entry) => entry.data.locale === translationLocale.code)
        .map((entry) => [
          entry.data.sourceSlug,
          {
            title: entry.data.title,
            description: entry.data.description,
          },
        ]),
    )
  : null;
const visibleRelated = relatedTranslations
  ? localizeRelatedPosts(related, relatedTranslations)
  : related;
const relatedHrefPrefix = translationLocale
  ? `/${translationLocale.prefix}`
  : '';
const newsletter = newsletterChrome(translationLocale?.code);

// ✅ Canonical URL from clean slug (self-canonical per language version)
const canonicalURL = new URL(canonicalPath, SITE_URL).toString();

const breadcrumbItems = [
  { label: chrome.home, href: '/' },
  // Link the canonical destination directly: the trailing-slash form 404s
  // even in production, and the bare form costs a redirect hop.
  { label: chrome.writing, href: '/writing/1' },
];

if (categoryNormalized) {
  breadcrumbItems.push({
    label: categoryLabel(categoryNormalized),
    href: `/writing/category/${encodeURIComponent(categoryNormalized)}/1`,
  });
}

breadcrumbItems.push({ label: title });
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
  authorName={SITE_AUTHOR}
  ogType="article"
  tags={tags}
  lang={translationLocale?.code ?? 'en'}
  hreflangs={hreflangs}
  ogLocale={pageOgLocale}
  ogLocaleAlternates={ogLocaleAlternates}
>
  <main>
    <article>
      <Breadcrumbs items={breadcrumbItems} />
      {
        hero && (
          <div class="hero-image">
            {typeof hero === 'object' ? (
              <Image
                src={hero}
                alt={`Hero for ${title}`}
                format="webp"
                width={1200}
                height={630}
                fit="cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <img
                src={hero}
                alt={`Hero for ${title}`}
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}
          </div>
        )
      }

      <div class="prose">
        <div class="title">
          <div class="meta">
            <FormattedDate date={pubDate} locale={dateLocale} />
            {category && ` · ${category}`}
            {readingTime && ` · ${readingTime} ${chrome.minReadUnit}`}
            {
              updatedDate && (
                <div class="last-updated-on">
                  {chrome.lastUpdated}{' '}
                  <FormattedDate date={updatedDate} locale={dateLocale} />
                </div>
              )
            }
          </div>
          <div class="lang-row">
            <LanguageSelector
              entries={langEntries}
              currentLabel={currentLabel}
            />
          </div>
          <h1>{title}</h1>
        </div>

        <!-- TOC -->
        <TableOfContents headings={headings} />

        <!-- Post content -->
        <slot />

        <footer class="article-footer">
          <div class="article-utilities">
            <TagList tags={tags} />
            <ShareButtons title={title} url={canonicalURL} />
          </div>

          <!-- Newsletter CTA: same backend; localized copy on translated pages -->
          <SubscribeForm
            compact={false}
            title={newsletter.title}
            emailLabel={newsletter.emailLabel}
            emailPlaceholder={newsletter.emailPlaceholder}
            subscribeLabel={newsletter.subscribeButton}
            successFull={newsletter.successFull}
            successCompact={newsletter.successCompact}
          />
        </footer>

        <!-- Discussion: same English thread; localized UI strings only -->
        <Discussion
          slug={slug}
          prompt={discussionPrompt}
          locale={translationLocale?.code}
        />

        <!-- Related posts -->
        {
          visibleRelated.length > 0 && (
            <section class="related-posts">
              <h2>{chrome.relatedPosts}</h2>
              <PostList
                posts={visibleRelated}
                variant="compact"
                hrefPrefix={relatedHrefPrefix}
              />
            </section>
          )
        }
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .hero-image {
    max-width: 1100px;
    margin: 0 auto 2rem auto;
  }
  .hero-image img,
  .hero-image :global(img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
  .title {
    margin-bottom: 2rem;
    text-align: center;
    line-height: 1.4;
  }
  .meta {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-meta));
  }
  .lang-row {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-md);
  }
  .lang-row:empty {
    display: none;
  }
  .last-updated-on {
    font-style: italic;
  }
  .title h1 {
    position: relative;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
  }
  .title h1::after {
    content: '';
    display: block;
    margin: 0.75rem auto 0 auto;
    width: 100%;
    height: 1px;
    background-color: #ddd;
  }
  .related-posts > h2 {
    margin-top: 0;
    margin-bottom: var(--space-lg);
    font-size: var(--text-xl);
  }
  .article-footer {
    margin-top: var(--space-xl);
  }
  .article-utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
  }
  .article-footer :global(.signup) {
    margin-top: var(--space-xl);
    margin-bottom: 0;
  }
  @media (max-width: 640px) {
    .article-utilities {
      align-items: flex-start;
      flex-direction: column;
    }
    .article-footer :global(.signup) {
      text-align: left;
    }
    .article-footer :global(.signup .signup-box) {
      justify-content: flex-start;
      margin-left: 0;
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import { SITE_AUTHOR, SITE_OG_IMAGE, SITE_URL } from '../consts';
import { comparePostsByDate, enrichPost } from '../utils/text';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TagList from '../components/TagList.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import Discussion from '../components/Discussion.astro';
import type { MarkdownHeading } from 'astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { categoryLabel } from '../utils/taxonomy';
import { articleHeroUrl } from '../utils/hero';

type Props = {
  post: CollectionEntry<'blog'> & { slug: string };
  headings?: MarkdownHeading[];
};

const { post, headings = [] } = Astro.props;

// ✅ Enrich once, then destructure from .data
const enrichedPost = enrichPost(post);
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  categoryNormalized,
  tags = [],
  readingTime,
  discussionPrompt,
} = enrichedPost.data;
const slug = enrichedPost.slug;
const hero = heroImage;

// Social image reuses the rendered hero transform, so `og:image` and
// `BlogPosting.image` point at the deployed 1200x630 asset instead of the
// smaller original source. Hero-less articles use the metadata-only fallback.
const socialImage = (await articleHeroUrl(hero)) ?? SITE_OG_IMAGE;

// ✅ Related posts (exclude by id)
const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => p.data.category === category && p.id !== post.id)
  .map(enrichPost)
  .sort(comparePostsByDate)
  .slice(0, 3);

// ✅ Canonical URL from clean slug
const canonicalURL = new URL(`/writing/${slug}`, SITE_URL).toString();

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  // Link the canonical destination directly: the trailing-slash form 404s
  // even in production, and the bare form costs a redirect hop.
  { label: 'Writing', href: '/writing/1' },
];

if (categoryNormalized) {
  breadcrumbItems.push({
    label: categoryLabel(categoryNormalized),
    href: `/writing/category/${encodeURIComponent(categoryNormalized)}/1`,
  });
}

breadcrumbItems.push({ label: title });
---

<BaseLayout
  title={title}
  description={description}
  image={socialImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
  authorName={SITE_AUTHOR}
  ogType="article"
  tags={tags}
>
  <main>
    <article>
      <Breadcrumbs items={breadcrumbItems} />
      {
        hero && (
          <div class="hero-image">
            {typeof hero === 'object' ? (
              <Image
                src={hero}
                alt={`Hero for ${title}`}
                format="webp"
                width={1200}
                height={630}
                fit="cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <img
                src={hero}
                alt={`Hero for ${title}`}
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}
          </div>
        )
      }

      <div class="prose">
        <div class="title">
          <div class="meta">
            <FormattedDate date={pubDate} />
            {category && ` · ${category}`}
            {readingTime && ` · ${readingTime} min read`}
            {
              updatedDate && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <h1>{title}</h1>
        </div>

        <!-- TOC -->
        <TableOfContents headings={headings} />

        <!-- Post content -->
        <slot />

        <footer class="article-footer">
          <div class="article-utilities">
            <TagList tags={tags} />
            <ShareButtons title={title} url={canonicalURL} />
          </div>

          <!-- Newsletter CTA -->
          <SubscribeForm compact={false} />
        </footer>

        <!-- Discussion -->
        <Discussion slug={slug} prompt={discussionPrompt} />

        <!-- Related posts -->
        {
          related.length > 0 && (
            <section class="related-posts">
              <h2>Related Posts</h2>
              <PostList posts={related} variant="compact" />
            </section>
          )
        }
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .hero-image {
    max-width: 1100px;
    margin: 0 auto 2rem auto;
  }
  .hero-image img,
  .hero-image :global(img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
  .title {
    margin-bottom: 2rem;
    text-align: center;
    line-height: 1.4;
  }
  .meta {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-meta));
  }
  .last-updated-on {
    font-style: italic;
  }
  .title h1 {
    position: relative;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
  }
  .title h1::after {
    content: '';
    display: block;
    margin: 0.75rem auto 0 auto;
    width: 100%;
    height: 1px;
    background-color: #ddd;
  }
  .related-posts > h2 {
    margin-top: 0;
    margin-bottom: var(--space-lg);
    font-size: var(--text-xl);
  }
  .article-footer {
    margin-top: var(--space-xl);
  }
  .article-utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
  }
  .article-footer :global(.signup) {
    margin-top: var(--space-xl);
    margin-bottom: 0;
  }
  @media (max-width: 640px) {
    .article-utilities {
      align-items: flex-start;
      flex-direction: column;
    }
    .article-footer :global(.signup) {
      text-align: left;
    }
    .article-footer :global(.signup .signup-box) {
      justify-content: flex-start;
      margin-left: 0;
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
